# Helper script to run blktests for blktests CI

usage () {
	echo "$0" "[OPTIONS] CONDITION_BASE_URL"
	echo -e "\tGet blktests run conditions from CONDITION_BASE_URL."
	echo -e "\tGenerate config file for each condition and run tests."
	echo -e "\tOPTIONS: -d\t Debug mode."
	exit 1
}

DEBUG_MODE=0

if [[ $1 == -d ]]; then
	shift
	DEBUG_MODE=1
fi

(($# != 1)) && usage

COND_URL_BASE=$1

cat_url() {
	local url=$1

	if [[ $url =~ http ]]; then
		curl --fail --location --silent --show-error --retry 3 "$url"
	else
		cat "$url"
	fi
}

get_conditions() {
	local url_base=$1
	local line list
	local -a conds

	list=$(cat_url "${url_base}/list") || return 1

	while read -r line; do
		conds+=("$line")
	done <<< "$list"
	echo "${conds[@]}"
}

dequote() {
	local str="$1"

	str=${str//\"/}
	str=${str//\'/}
	echo "$str"
}

gen_config() {
	local url=$1
	local content line check_args
	local devs
	local -a test_devs
	local -a check_args_arr

	if ! content=$(cat_url "$url"); then
		echo "run_ci: failed to get condition ${url}" >&2
		exit 1
	fi

	check_args=${url##*/}

	rm -f config

	while read -r line; do
		if [[ $line =~ BLKTESTS_CI_CHECK_ARGS ]]; then
			check_args=${line##*=}
			check_args=$(dequote "$check_args")
		elif [[ $line =~ BLKTESTS_CI_TEST_DEVS ]]; then
			devs=${line##*=}
			devs=$(dequote "$devs")
			for dev in $devs; do
				test_devs+=("${!dev}")
			done
			echo "TEST_DEVS=(" "${test_devs[@]}" ")" >> config
		else
			echo "$line" >> config
		fi
	done <<< "$content"

	# shellcheck disable=SC2206
	check_args_arr=(${check_args})

	echo "run_ci: ${url}"
	if [[ -f ./config ]]; then
		cat ./config
	fi
	if ((DEBUG_MODE)); then
		echo -e "sudo ./check ${check_args_arr[*]}\n"
	else
		sudo mkdir -p results
		sudo rm -f results/results.json results/failures
		sudo touch results/failures
		sudo chmod oug+rw results/failures
		sudo ./check "${check_args_arr[@]}" --json results/results.json
		if [[ -f results/results.json ]]; then
			sudo chmod oug+r results/results.json
			# shellcheck disable=SC2024
			sudo jq --raw-output \
			     '.results[] | select(.status == "fail") | .name' \
			     results/results.json >> results/failures
			sudo rm -f results/results.json
		fi
		if (( $(stat -c%s results/failures) > 0 )); then
			local -a failures
			local line
			while read -r line; do
				failures+=("$line")
			done < results/failures
			if (( $(stat -c%s all_failures) > 0 )); then
				echo -n " " >> all_failures
			fi
			echo -n "${failures[@]}" >> all_failures
		fi
	fi
}

rm -f all_failures

if ! conditions=$(get_conditions "$COND_URL_BASE") || [[ -z $conditions ]]; then
	echo "run_ci: failed to get test conditions from ${COND_URL_BASE}/list" >&2
	exit 1
fi

for condition in $conditions; do
	gen_config "$COND_URL_BASE"/"$condition"
done

exit 0
